APP_NAME=Wervelnieuws API
ENV=development
SECRET_KEY=change-this-secret-key
# ACCESS_TOKEN_EXPIRE_MINUTES optional; defaults to AUTH_COOKIE_TTL_DAYS (30 dagen)
# AUTH_COOKIE_SECURE=true in productie (HTTPS)
REMEMBER_COOKIE_NAME=wervel_remember
REMEMBER_COOKIE_MAX_AGE_DAYS=400

DATABASE_URL=sqlite:////data/app.db
STORAGE_ROOT=/data
UPLOADS_DIR=uploads
GENERATED_DIR=generated
EXPORTS_DIR=exports

API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8001/api
SCHEDULER_POLL_SECONDS=30
WORKER_LEASE_SECONDS=90
MAX_RETRY_ATTEMPTS=5
UPLOAD_MAX_BYTES=104857600
WORK_HOURS_IMPORT_MAX_BYTES=2097152
WORK_HOURS_IMPORT_MAX_DEPTH=20
WORK_HOURS_IMPORT_MAX_NODES=5000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-4.1-mini
OPENAI_MODEL_IMAGE=gpt-image-1

WEBSITE_PUBLISH_URL=
WEBSITE_PUBLISH_TOKEN=

FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_LIST_ADDRESS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

N8N_WEBHOOK_URL=
N8N_REJECT_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SECONDS=10
